from collections.abc import Callable, Sequence
from typing import Protocol

class Vertex:
    def __init__(self, q: int, r: int, index: int) -> None: ...
    @property
    def q(self) -> int: ...
    @property
    def r(self) -> int: ...
    @property
    def index(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def hexes(self) -> list[Hex]: ...

class Edge:
    def __init__(self, q: int, r: int, index: int) -> None: ...
    @property
    def q(self) -> int: ...
    @property
    def r(self) -> int: ...
    @property
    def index(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def vertices(self) -> list[Vertex]: ...

class Hex:
    @property
    def q(self) -> int: ...
    @property
    def r(self) -> int: ...

class Tile:
    @property
    def q(self) -> int: ...
    @property
    def r(self) -> int: ...
    @property
    def number(self) -> int: ...
    @property
    def terrain(self) -> str: ...

class Harbour:
    @property
    def edge(self) -> Edge: ...
    @property
    def kind(self) -> str: ...

class Board:
    @staticmethod
    def from_seed(seed: int) -> Board: ...
    @property
    def tiles(self) -> list[Tile]: ...
    @property
    def desert(self) -> Hex: ...
    @property
    def harbours(self) -> list[Harbour]: ...

class RandomPlayer:
    @staticmethod
    def from_seed(seed: int) -> RandomPlayer: ...

type Placement = tuple[Vertex, Edge] | None
type PriorPlacement = tuple[int, Vertex, Edge]

class Report:
    @property
    def errors(self) -> list[list[str]]: ...
    @property
    def placements(self) -> list[tuple[Placement, Placement]]: ...

class Player(Protocol):
    def choose(
        self,
        board: Board,
        available: list[tuple[Vertex, Edge]],
        prior: list[PriorPlacement],
        errors: list[str],
    ) -> tuple[Vertex, Edge]: ...

type Chooser = Callable[
    [Board, list[tuple[Vertex, Edge]], list[PriorPlacement], list[str]],
    tuple[Vertex, Edge],
]

class Simulator:
    def __init__(
        self,
        board: Board,
        players: Sequence[RandomPlayer | Player | Chooser],
    ) -> None: ...
    def simulate(self, max_errors: int) -> Report: ...
