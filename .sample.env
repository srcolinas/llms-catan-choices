# shellcheck shell=sh disable=SC2034

# Define path to documents
SOLVER_HEURISTICS=solver/docs/heuristics.md


# pydantic-ai model id (`provider:model`). Credentials use the provider's own env vars.
# SOLVER_LLM_MODEL=openai:gpt-4o
# OPENAI_API_KEY=sk-...

# SOLVER_LLM_MODEL=anthropic:claude-sonnet-4-5
# ANTHROPIC_API_KEY=...

# SOLVER_LLM_MODEL=ollama:qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Local decision model over the System One API. No /v1 suffix.
# SOLVER_SYSTEM_ONE_MODEL=nimble
# SYSTEM_ONE_BASE_URL=http://localhost:11434

# OpenAI Decisions API (`--players openai-decision`). The SDK reads OPENAI_API_KEY.
# SOLVER_OPENAI_DECISION_MODEL=gpt-6-luna
# OPENAI_API_KEY=sk-...

SOLVER_LLM_MODEL=gateway/openai:gpt-5.6-luna
PYDANTIC_AI_GATEWAY_API_KEY=...

# TYPESAFE_API_KEY=...

# Local Langfuse from `task start-langfuse`. Used only with `solve --langfuse`.
SOLVER_LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
SOLVER_LANGFUSE_SECRET_KEY=sk-lf-local-dev
SOLVER_LANGFUSE_BASE_URL=http://localhost:3000


